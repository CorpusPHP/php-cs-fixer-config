{
    "name": "corpus/php-cs-fixer-config",
    "description": "Shared PHP-CS-Fixer configuration for Corpus projects.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jesse G. Donat",
            "email": "donatj@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4 || ~8.0.0 || ~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "require-dev": {
        "corpus/coding-standard": "^0.10",
        "donatj/mddoc": "=0.14.1",
        "phpunit/phpunit": "^9.6 || ^11.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Corpus\\PhpCsFixer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Corpus\\PhpCsFixer\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
